# Copy to .env and fill in. Never commit .env.

# LLM: "anthropic", or "fake" (no API key; canned responses for offline dev/demo)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5)
LLM_MODEL="claude-haiku-5-5"

# Encoders (must match what the Chroma index was built with; re-run ingest.py after changing)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional: where the Chroma index lives (default: backend/chroma)
CHROMA_DIR=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
